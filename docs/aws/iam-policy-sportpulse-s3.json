{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectSportPulseBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME",
        "arn:aws:s3:::REPLACE_WITH_ARTIFACTS_BUCKET_NAME"
      ]
    },
    {
      "Sid": "WriteSportPulseObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME/*",
        "arn:aws:s3:::REPLACE_WITH_ARTIFACTS_BUCKET_NAME/*"
      ]
    }
  ]
}
