# SportPulse AI / example — COPIER en .env et adapter. NE JAMAIS COMMITTER .env.
# L'application se connecte au conteneur postgres sur le port Docker interne 5432.
POSTGRES_DB=sportpulse
POSTGRES_USER=sportpulse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://sportpulse:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/sportpulse
KESTRA_DB_PASSWORD=CHANGE_ME_STRONG_KESTRA_PASSWORD
MB_ENCRYPTION_SECRET_KEY=CHANGE_ME_RANDOM_ENCRYPTION_SECRET_32_CHARS
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# Chemin absolu vers la racine du dépôt hôte (requis par les tâches Docker de Kestra).
SPORTPULSE_HOST_PROJECT_DIR=/ABSOLUTE/PATH/TO/SportPulse_AI_GitHub
SPORTPULSE_DOCKER_NETWORK=sportpulse-ai-step_default

# Sécurité et portail (valeurs d'exemple uniquement).
SPORTPULSE_VALIDATION_SECRET=CHANGE_ME_RANDOM_VALIDATION_SECRET
SPORTPULSE_AI_TOKEN=CHANGE_ME_RANDOM_AI_TOKEN
ADMIN_DEMO_MODE=false
PORTAL_COOKIE_SECURE=false
PORTAL_SOCIAL_YEAR_START_MONTH=1
OFFICE_ARRIVAL_QR_SECRET=
OFFICE_QR_ADMIN_KEY=
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_GEOFENCE_RADIUS_M=150
OSRM_BASE_URL=https://routing.openstreetmap.de

# Notifications : opt-in explicite en dry_run par défaut, jamais de publication réelle.
SPORTPULSE_SLACK_MODE=dry_run
SLACK_BOT_TOKEN=
SLACK_CHANNEL_DEFAULT=
SPORTPULSE_SLACK_CHANNELS_JSON={}
SLACK_WEBHOOK_URL=
SPORTPULSE_MOTIVATION_BACKEND=template
SPORTPULSE_MOTIVATION_MODEL=ministral-3b-latest
MISTRAL_API_KEY=
SPORTPULSE_RAG_BACKEND=lexical

# Kestra -> S3 / AWS : fournir des identifiants autorisés localement.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
S3_BUCKET_RAW=REPLACE_WITH_RAW_BUCKET_NAME
S3_BUCKET_ARTIFACTS=REPLACE_WITH_ARTIFACTS_BUCKET_NAME
